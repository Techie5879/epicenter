{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "home-model-administration-development",
	"description": "Whispering local-model administration owns the active model, downloads, deletion, and unload policy (ADR-0180). Wiring, not a sandbox: it routes those commands to the model-administration window.",
	"local": false,
	"windows": ["home"],
	"remote": {
		"urls": ["http://127.0.0.1:*"]
	},
	"permissions": [
		"core:event:allow-listen",
		"allow-list-models",
		"allow-download-model",
		"allow-cancel-download",
		"allow-delete-model",
		"allow-get-active-model",
		"allow-set-active-model",
		"allow-get-local-transcription-readiness",
		"allow-get-unload-policy",
		"allow-set-unload-policy"
	]
}
